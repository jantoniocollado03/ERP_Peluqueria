<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ERP_Peluqueria.Pages.LoginView">
    <Grid Background="#F8F9FA">
        <Border Width="360"
                Padding="24"
                Background="White"
                CornerRadius="8"
                BoxShadow="0 4 12 #20000000"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
            <StackPanel Spacing="14">
                <TextBlock Text="Iniciar Sesión" 
                           FontSize="20" 
                           FontWeight="Bold" 
                           HorizontalAlignment="Center" />
                
                <Border x:Name="ErrorBorder" 
                        Background="#F8D7DA" 
                        CornerRadius="4" 
                        Padding="8" 
                        IsVisible="False">
                    <TextBlock x:Name="ErrorMessageText" Foreground="#842029" TextWrapping="Wrap" />
                </Border>

                <StackPanel Spacing="4">
                    <TextBlock Text="Usuario" FontWeight="Medium" />
                    <TextBox x:Name="UsernameBox" Watermark="admin o lucia" />
                </StackPanel>

                <StackPanel Spacing="4">
                    <TextBlock Text="Contraseña" FontWeight="Medium" />
                    <TextBox x:Name="PasswordBox" PasswordChar="•" Watermark="admin123 o lucia123" />
                </StackPanel>

                <Button Content="Entrar al Sistema"
                        Background="#212529"
                        Foreground="White"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        Padding="10"
                        Click="BtnLogin_Click" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>