<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ERP_Peluqueria.Pages.ArticulosView">
    <Grid Margin="20" ColumnDefinitions="2*, 1*">
        <!-- Lista y filtros -->
        <Grid Grid.Column="0" RowDefinitions="Auto, *" Margin="0,0,15,0">
            <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="10" Margin="0,0,0,12">
                <TextBox x:Name="TxtBuscar" Width="260" Watermark="Buscar artículo o servicio..." TextChanged="TxtBuscar_TextChanged" />
                <Button Content="Refrescar" Click="BtnRefrescar_Click" Background="#6C757D" Foreground="White" />
            </StackPanel>

            <DataGrid Grid.Row="1" x:Name="GridArticulos" AutoGenerateColumns="False" IsReadOnly="True"
                      SelectionChanged="GridArticulos_SelectionChanged" GridLinesVisibility="All">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Nombre" Binding="{Binding Nombre}" Width="*" />
                    <DataGridTextColumn Header="Tipo" Binding="{Binding Tipo}" Width="100" />
                    <DataGridTextColumn Header="Precio" Binding="{Binding Precio, StringFormat='{}{0:C}'}" Width="90" />
                    <DataGridTextColumn Header="Stock" Binding="{Binding Stock}" Width="80" />
                    <DataGridTextColumn Header="Duración (min)" Binding="{Binding DuracionMinutos}" Width="110" />
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <!-- Formulario lateral -->
        <Border Grid.Column="1" Background="White" CornerRadius="8" Padding="16" BoxShadow="0 2 8 #15000000">
            <StackPanel Spacing="10">
                <TextBlock x:Name="TxtTituloForm" Text="Nuevo Artículo / Servicio" FontSize="16" FontWeight="Bold" />

                <TextBlock Text="Nombre:" />
                <TextBox x:Name="TxtNombre" />

                <TextBlock Text="Tipo:" />
                <ComboBox x:Name="CmbTipo" HorizontalAlignment="Stretch" SelectedIndex="0" SelectionChanged="CmbTipo_SelectionChanged">
                    <ComboBoxItem Content="Servicio" />
                    <ComboBoxItem Content="Producto" />
                </ComboBox>

                <TextBlock Text="Precio (€):" />
                <TextBox x:Name="TxtPrecio" Watermark="15.50" />

                <!-- Visible según tipo -->
                <StackPanel x:Name="PanelStock" Spacing="4" IsVisible="False">
                    <TextBlock Text="Stock disponible:" />
                    <TextBox x:Name="TxtStock" Watermark="10" />
                </StackPanel>

                <StackPanel x:Name="PanelDuracion" Spacing="4">
                    <TextBlock Text="Duración estimada (minutos):" />
                    <TextBox x:Name="TxtDuracion" Watermark="30" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,15,0,0">
                    <Button Content="Guardar" Click="BtnGuardar_Click" Background="#198754" Foreground="White" />
                    <Button Content="Limpiar" Click="BtnLimpiar_Click" Background="#6C757D" Foreground="White" />
                    <Button x:Name="BtnEliminar" Content="Eliminar" Click="BtnEliminar_Click" Background="#DC3545" Foreground="White" IsVisible="False" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>