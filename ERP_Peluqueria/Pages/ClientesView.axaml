<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ERP_Peluqueria.Pages.ClientesView">
    <Grid Margin="20" ColumnDefinitions="2*, 1*">
        <!-- Lista y buscador -->
        <Grid Grid.Column="0" RowDefinitions="Auto, *" Margin="0,0,15,0">
            <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="10" Margin="0,0,0,12">
                <TextBox x:Name="TxtBuscar" Width="260" Watermark="Buscar por nombre o teléfono..." TextChanged="TxtBuscar_TextChanged" />
                <Button Content="Refrescar" Click="BtnRefrescar_Click" Background="#6C757D" Foreground="White" />
            </StackPanel>

            <DataGrid Grid.Row="1" x:Name="GridClientes" AutoGenerateColumns="False" IsReadOnly="True"
                      SelectionChanged="GridClientes_SelectionChanged" GridLinesVisibility="All">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Nombre" Binding="{Binding Nombre}" Width="150" />
                    <DataGridTextColumn Header="Teléfono" Binding="{Binding Telefono}" Width="120" />
                    <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="160" />
                    <DataGridTextColumn Header="Historial Técnico" Binding="{Binding HistorialTecnico}" Width="*" />
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <!-- Formulario lateral -->
        <Border Grid.Column="1" Background="White" CornerRadius="8" Padding="16" BoxShadow="0 2 8 #15000000">
            <StackPanel Spacing="10">
                <TextBlock x:Name="TxtTituloForm" Text="Nuevo Cliente" FontSize="16" FontWeight="Bold" />
                
                <TextBlock Text="Nombre completo:" />
                <TextBox x:Name="TxtNombre" />

                <TextBlock Text="Teléfono:" />
                <TextBox x:Name="TxtTelefono" />

                <TextBlock Text="Email:" />
                <TextBox x:Name="TxtEmail" />

                <TextBlock Text="Historial Técnico / Observaciones:" />
                <TextBox x:Name="TxtHistorial" AcceptsReturn="True" Height="100" TextWrapping="Wrap" 
                         Watermark="Fórmula de tinte, alergias, tipo de corte..." />

                <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,10,0,0">
                    <Button Content="Guardar" Click="BtnGuardar_Click" Background="#198754" Foreground="White" />
                    <Button Content="Limpiar" Click="BtnLimpiar_Click" Background="#6C757D" Foreground="White" />
                    <Button x:Name="BtnEliminar" Content="Eliminar" Click="BtnEliminar_Click" Background="#DC3545" Foreground="White" IsVisible="False" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>